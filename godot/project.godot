; Engine configuration file.
; Projeto Godot 4.x — World Cup Beasts (port do beasts.html)

config_version=5

[application]

config/name="World Cup Beasts"
config/description="Duelo de futebol por turnos — mecânica de 4 barras. Port do protótipo web (beasts.html)."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")

[display]

window/size/viewport_width=820
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
